<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.palabraventura.controller.GameController">

    <!-- Top: Puntaje -->
    <top>
        <VBox alignment="CENTER" spacing="10" BorderPane.alignment="CENTER">
            <Label fx:id="scoreLabel"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
            </Label>
        </VBox>
    </top>

    <!-- Center: Pregunta y opciones -->
    <center>
        <VBox alignment="CENTER" spacing="20">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label fx:id="questionLabel"
                   wrapText="true"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-alignment: center;" />

            <VBox spacing="12" alignment="CENTER">
                <Button fx:id="optionButton1" onAction="#handleOption1" prefWidth="300" />
                <Button fx:id="optionButton2" onAction="#handleOption2" prefWidth="300" />
                <Button fx:id="optionButton3" onAction="#handleOption3" prefWidth="300" />
                <Button fx:id="optionButton4" onAction="#handleOption4" prefWidth="300" />
            </VBox>

            <Label fx:id="messageLabel" style="-fx-font-size: 16px; -fx-text-fill: #444;" />
        </VBox>
    </center>

    <!-- Bottom: Botón siguiente -->
    <bottom>
        <VBox alignment="CENTER" spacing="10" BorderPane.alignment="CENTER">
            <Button fx:id="nextButton"
                    text="Siguiente"
                    onAction="#handleNextWord"
                    disable="true"
                    style="-fx-font-size: 14px; -fx-padding: 10 20;" />
        </VBox>
    </bottom>

</BorderPane>
