<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.palabraventura.controller.MinigameController">

    <top>
        <Label fx:id="titleLabel" text="Encuentra la pareja correcta"
               style="-fx-font-size: 20px; -fx-padding: 20px;" BorderPane.alignment="CENTER" />
    </top>

    <center>
        <GridPane fx:id="gridPane" hgap="10" vgap="10" alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
        </GridPane>
    </center>

    <bottom>
        <VBox alignment="CENTER" spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Label fx:id="statusLabel" />
            <Label fx:id="scoreLabel" text="Puntaje: 0" style="-fx-font-weight: bold;" />
            <Button fx:id="backButton" text="Volver" onAction="#handleBack"/>
        </VBox>
    </bottom>
</BorderPane>
